# nginx in front of the app (same container, host network). The entrypoint
# fills in __WEB_PORT__. The app listens on unix sockets, so nothing else on the
# NAS's host network can take its port. Upload bodies go to extra worker
# processes, because one Python process tops out near one CPU core; the main
# app is the fallback.

# Only cloudflared (connecting from 127.0.0.1) may say the visit was https or
# name the real client. Everyone else gets their own address and scheme. The app
# trusts these headers because only nginx can reach its sockets.
map "$remote_addr|$http_x_forwarded_proto" $fwd_proto {
    "~^127\.0\.0\.1\|https$" https;
    default $scheme;
}
map "$remote_addr|$http_cf_connecting_ip" $client_ip {
    "~^127\.0\.0\.1\|(?<cf>[0-9A-Fa-f:.]+)$" $cf;
    default $remote_addr;
}

upstream ugd_app {
    server unix:/run/ugreen-drive/app.sock;
    keepalive 32;
}

upstream ugd_upload {
    least_conn;
    server unix:/run/ugreen-drive/upload-0.sock;
    server unix:/run/ugreen-drive/upload-1.sock;
    server unix:/run/ugreen-drive/upload-2.sock;
    server unix:/run/ugreen-drive/app.sock backup;
    keepalive 32;
}

server {
    listen __WEB_PORT__;
    server_name _;

    # Query strings carry share-link and hand-off tokens; don't keep them on disk.
    access_log off;

    client_max_body_size 50g;
    client_body_timeout 3600s;
    client_header_timeout 120s;
    send_timeout 3600s;
    keepalive_timeout 120s;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml application/xml;

    # Versioned static files (?v= on JS/CSS/PNG): safe to cache hard.
    location /assets/ {
        proxy_pass http://ugd_app;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $client_ip;
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_set_header Connection "";
        proxy_buffering on;
        proxy_connect_timeout 30s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header CDN-Cache-Control "public, max-age=31536000, immutable" always;
    }

    location /api/thumbnail {
        proxy_pass http://ugd_app;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $client_ip;
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_set_header Connection "";
        proxy_buffering on;
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    # Small JSON responses: buffered and gzipped.
    location ~ ^/api/(files|search|folder-sizes|me|usage|config)$ {
        proxy_pass http://ugd_app;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $client_ip;
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_set_header Connection "";
        proxy_buffering on;
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "private, no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
    }

    location ~ ^/api/(upload/chunk|speedtest/upload)$ {
        proxy_pass http://ugd_upload;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $client_ip;
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_max_temp_file_size 0;
        proxy_connect_timeout 5s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "private, no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
    }

    location /api/ {
        proxy_pass http://ugd_app;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $client_ip;
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_max_temp_file_size 0;
        proxy_connect_timeout 60s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "private, no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
    }

    location /auth/ {
        proxy_pass http://ugd_app;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $client_ip;
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_set_header Connection "";
        proxy_hide_header Cache-Control;
        add_header Cache-Control "private, no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
    }

    location / {
        proxy_pass http://ugd_app;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $client_ip;
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_max_temp_file_size 0;
        proxy_connect_timeout 60s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=60, must-revalidate" always;
    }
}
