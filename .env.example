# Optional. ugreen-drive needs no environment variables: everything below can
# be set in the drive's Settings page instead. Values here are only defaults.
# In UGOS, add them under `environment:` in the compose file.

# Name shown on the sign-in page, in the tab title and in emails.
DRIVE_NAME=Drive

# Address you use away from home, e.g. through a Cloudflare Tunnel.
# Empty: the LAN address.
PUBLIC_BASE_URL=https://drive.example.com

# The NAS's direct LAN address. Empty: detected at startup (http://<NAS-IP>:8790).
LAN_ORIGIN=

# Port nginx listens on (host network).
WEB_PORT=8790

# Google sign-in (OAuth web client; redirect URI <PUBLIC_BASE_URL>/auth/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email-code sign-in via Resend (verified sending domain).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# At least 32 random characters. Empty: generated on first start into /config/session_secret.
SESSION_SECRET=
